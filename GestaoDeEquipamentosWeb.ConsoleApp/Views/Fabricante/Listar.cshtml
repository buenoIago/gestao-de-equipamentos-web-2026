@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model List<Fabricante>;

<h1>Gestão de Equipamentos<H1>

<hr>
    <a href="">Início</a> -
    <a href="/Fabricante/Listar">Controle de Fabricantes</a> -
    <a href="/Equipamento/Listar">Controle de Equipamento</a> -
    <a href="/Chamado/Listar">Controle de Chamado</a> -
    <a href="https://www.academiadoprogramador.net" target="_blank">/Academia do Programador</a>
<hr>

<h2>Listagem de Fabricantes</h2>

<hr>
    <a href="/Fabricante/Cadastrar">Cadastrar Novo</a>
<hr>

<Table>
    <thead>
        <tr>
            <td>| ID |</td>
            <td> Nome | </td>
            <td> Email |</td>
            <td> Telefone |</td>
            <td> Ações |</td>
        </tr>
    </thead>
    <tbody>
        @foreach (Fabricante f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td><a href="/Fabricante/Editar/@f.Id">Editar</a></td>
                <td><a href="/Fabricante/Excluir/">Excluir</a></td>
            </tr>   
        }
    </tbody>
</Table>

