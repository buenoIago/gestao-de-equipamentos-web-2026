@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Fabricantes";
}

@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model List<Fabricante>;

<a class="btn-cadastrar" href="/Fabricante/Cadastrar">Cadastrar Novo</a>

<Table class="registros">
    <thead>
        <tr>
            <th> ID </th>
            <th> Nome  </th>
            <th> Email </th>
            <th> Telefone </th>
            <th> Ações </th>
        </tr>
    </thead>
    <tbody>
        @foreach (Fabricante f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="/Fabricante/Editar/@f.Id">Editar</a>
                    <a href="/Fabricante/Excluir/">Excluir</a>
                </td>
            </tr>   
        }
    </tbody>
</Table>