@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model Fabricante

<h1>Gestão de Equipamentos<H1>

<hr>
    <a href="/Fabricante/Listar">Controle de Fabricantes</a> -
    <a href="/Equipamento/Listar">Controle de Equipamento</a> -
    <a href="/Chamado/Listar">Controle de Chamado</a> -
    <a href="https://www.academiadoprogramador.net" target="_blank">/Academia do Programador</a>
<hr>

<h2>Exclusão de Fabricantes</h2>

<form action="/Fabricante/Excluir/@Model.Id  "method="post">
    <div>
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>

    <div>
        <label>Email</label>
        <br>
        <input type="text" name="Email" value="@Model.Email" disabled>
    </div>

    <div>
        <label>Telefone</label>
        <br>
        <input type="text" name="Telefone" value="@Model.Telefone" disabled>
    </div>  

    <hr>
    
    <a href="Fabricante/Listar">Voltar</a>
    <button type="submit"">Confirmar</button>

</form>
