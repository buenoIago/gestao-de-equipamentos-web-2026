@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Fabricantes";
}

@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model Fabricante

<form class="formulario" action="/Fabricante/Excluir/@Model.Id  "method="post">

    <p class="formulario-alerta">Deseja realmente excluir este Fabricante?</p>

    <div>
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>

    <div class="formulario-campo">
        <label>Email</label>
        <br>
        <input type="text" name="Email" value="@Model.Email" disabled>
    </div>

    <div class="formulario-campo">
        <label>Telefone</label>
        <br>
        <input type="text" name="Telefone" value="@Model.Telefone" disabled>
    </div>  

    <hr>
    <div class="formulario-acoes">
        <a href="Fabricante/Listar">Voltar</a>
        <button type="submit"">Confirmar</button>
    </div>

</form>
