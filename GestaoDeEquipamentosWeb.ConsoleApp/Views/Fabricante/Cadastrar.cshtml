@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Fabricantes";
}

<form class="formulario" action="/Fabricante/Cadastrar "" method="post">

    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome">
    </div>

    <div class="formulario-campo">
        <label>Email</label>
        <br>
        <input type="text" name="Email">
    </div>

    <div class="formulario-campo">
        <label>Telefone</label>
        <br>
        <input type="text" name="Telefone">
    </div>  

    <hr>

    <div class="formulario-acoes">
        <a href="/Fabricante/Listar">Voltar</a>
        <button type="submit"">Confirmar</button>
    </div>


</form>
